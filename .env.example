# ──────────────────────────────────────
# Infrastructure (used by infra/docker-compose.yml)
# ──────────────────────────────────────
POSTGRES_USER=ats_user
POSTGRES_PASSWORD=ats_password
POSTGRES_DB=ats_db
POSTGRES_PORT=5432
REDIS_PORT=6379
ADMINER_PORT=8080

# ──────────────────────────────────────
# API (apps/api)
# ──────────────────────────────────────
NODE_ENV=development
API_PORT=3000
DATABASE_URL=postgresql://ats_user:ats_password@localhost:5432/ats_db
REDIS_URL=redis://localhost:6379
JWT_SECRET=dev-secret-change-in-production

# ──────────────────────────────────────
# Worker (apps/worker)
# ──────────────────────────────────────
WORKER_PORT=8000
WORKER_DATABASE_URL=postgresql://ats_user:ats_password@localhost:5432/ats_db
WORKER_REDIS_URL=redis://localhost:6379

# ──────────────────────────────────────
# Blob Storage (MinIO / S3)
# ──────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
BLOB_STORAGE_BUCKET=ats-blobs

# ──────────────────────────────────────
# AI/LLM Services
# ──────────────────────────────────────
# Anthropic API key for Claude-based learning interventions
ANTHROPIC_API_KEY=
