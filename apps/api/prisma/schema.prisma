  isTabVisible     Boolean  @default(true)
  computedAt       DateTime @default(now())

  @@unique([sessionId, frameId])
  @@index([sessionId, frameTMs])
}

// ─── EF / Learning-Construct Text-Mining ────────────────

model EfDetection {
  id            String   @id @default(cuid())
  messageId     String
  // The dialogue-session ID the message was sent in. Used by the
  // teacher's text-mining dashboard / live feed to scope detections to
  // a single chat thread.
  sessionId     String
  // The activity / login-session ID (StudentSession.id) the student was
  // in when they sent the message. Optional because pre-existing rows
  // were inserted before this column existed, and because the dialogue
  // can in principle be sent without an active /session/open. Used by
  // the retro-tracing episode-timeline service to surface EF events on
  // the same timeline as everything else (which is keyed by
  // StudentSession.id).
  studentSessionId String?
  studentId     String
  courseId      String?
  constructKey  String
  label         String
  confidence    Float?
  severity      Int?
  rationale     String?
  warning       String?
  rawJson       Json?
  provider      String
  model         String
  promptVersion Int
  latencyMs     Int?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([sessionId, constructKey, createdAt])
  @@index([studentSessionId, constructKey, createdAt])
  @@index([studentId, constructKey, createdAt])
  @@index([messageId])
  @@map("ef_detections")
}

model EfConstructPrompt {
  id           String   @id @default(cuid())
  courseId     String?
  constructKey String
  promptText   String   @db.Text
  version      Int
  updatedBy    String
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([courseId, constructKey, version])
  @@index([courseId, constructKey])
  @@map("ef_construct_prompts")
}

model EfTeacherSettings {
  id                        String   @id @default(cuid())
  teacherId                 String   @unique @map("teacher_id")
  rollingWindowN            Int      @default(5) @map("rolling_window_n")
  detectionConcurrency      Int      @default(6) @map("detection_concurrency")
  disableLowFeasibility     Boolean  @default(false) @map("disable_low_feasibility")
  detectionProviderOverride String?  @map("detection_provider_override")
  detectionModelOverride    String?  @map("detection_model_override")
  pauseIngestion            Boolean  @default(false) @map("pause_ingestion")
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("ef_teacher_settings")
}

// ─── OpenFace 3 Emotion Detection ───────────────────────

enum Openface3JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

model Openface3Job {
  id                 String             @id @default(cuid())
  recordingSegmentId String             @unique @map("recording_segment_id")
  recordingSegment   RecordingSegment   @relation(fields: [recordingSegmentId], references: [id], onDelete: Cascade)
  status             Openface3JobStatus @default(PENDING)
  extractionFps      Int                @default(5) @map("extraction_fps")
  detectorBackend    String             @default("retinaface") @map("detector_backend")
  framesProcessed    Int                @default(0) @map("frames_processed")
  framesWithFace     Int                @default(0) @map("frames_with_face")
  errorMessage       String?            @map("error_message")
  retries            Int                @default(0)
  startedAt          DateTime?          @map("started_at") @db.Timestamptz
  completedAt        DateTime?          @map("completed_at") @db.Timestamptz
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz

  emotionFrames EmotionFrame[]

  @@index([status])
  @@index([recordingSegmentId])
  @@map("openface3_jobs")
}

model EmotionFrame {
  id    String       @id @default(cuid())
  jobId String       @map("job_id")
  job   Openface3Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  sessionId String @map("session_id")
  userId    String @map("user_id")
  courseId  String @map("course_id")

  frameWallMs  BigInt  @map("frame_wall_ms")
  frameIndex   Int     @map("frame_index")
  faceDetected Boolean @map("face_detected")

  pHappiness Float? @map("p_happiness")
  pSadness   Float? @map("p_sadness")
  pSurprise  Float? @map("p_surprise")
  pFear      Float? @map("p_fear")
  pAnger     Float? @map("p_anger")
  pDisgust   Float? @map("p_disgust")
  pContempt  Float? @map("p_contempt")
  pNeutral   Float? @map("p_neutral")

  dominantEmotion     String? @map("dominant_emotion")
  dominantProbability Float?  @map("dominant_probability")

  headPoseYaw   Float? @map("head_pose_yaw")
  headPosePitch Float? @map("head_pose_pitch")
  headPoseRoll  Float? @map("head_pose_roll")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([sessionId, frameWallMs])
  @@index([userId, frameWallMs])
  @@index([courseId, frameWallMs])
  @@index([jobId])
  @@map("emotion_frames")
}

// ─── Affective State Mapping (Stage 3) ──────────────────

model AffectiveMappingConfig {
  id                 String   @id @default(cuid())
  courseId           String   @unique @map("course_id") @db.Uuid
  course             Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  windowSeconds      Int      @default(30) @map("window_seconds")
  strideSeconds      Int      @default(10) @map("stride_seconds")
  minFramesPerWindow Int      @default(5) @map("min_frames_per_window")
  rules              Json
  version            Int      @default(1)
  updatedById        String?  @map("updated_by_id")
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz

  history AffectiveMappingConfigHistory[]
  windows AffectiveStateWindow[]

  @@map("affective_mapping_configs")
}

model AffectiveMappingConfigHistory {
  id                 String                 @id @default(cuid())
  configId           String                 @map("config_id")
  config             AffectiveMappingConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  version            Int
  windowSeconds      Int                    @map("window_seconds")
  strideSeconds      Int                    @map("stride_seconds")
  minFramesPerWindow Int                    @map("min_frames_per_window")
  rules              Json
  changedById        String?                @map("changed_by_id")
  changedAt          DateTime               @default(now()) @map("changed_at") @db.Timestamptz

  @@unique([configId, version])
  @@index([configId])
  @@map("affective_mapping_config_history")
}

model AffectiveStateWindow {
  id                String                 @id @default(cuid())
  sessionId         String                 @map("session_id")
  userId            String                 @map("user_id")
  courseId          String                 @map("course_id")
  configId          String                 @map("config_id")
  config            AffectiveMappingConfig @relation(fields: [configId], references: [id])
  configVersion     Int                    @map("config_version")
  windowStartWallMs BigInt                 @map("window_start_wall_ms")
  windowEndWallMs   BigInt                 @map("window_end_wall_ms")
  framesInWindow    Int                    @map("frames_in_window")
  framesWithFace    Int                    @map("frames_with_face")
  engagement        Float
  boredom           Float
  confusion         Float
  frustration       Float
  dominantState     String                 @map("dominant_state")
  meanHappiness     Float?                 @map("mean_happiness")
  meanSadness       Float?                 @map("mean_sadness")
  meanSurprise      Float?                 @map("mean_surprise")
  meanFear          Float?                 @map("mean_fear")
  meanAnger         Float?                 @map("mean_anger")
  meanDisgust       Float?                 @map("mean_disgust")
  meanContempt      Float?                 @map("mean_contempt")
  meanNeutral       Float?                 @map("mean_neutral")
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz

  @@unique([sessionId, windowStartWallMs, configVersion])
  @@index([sessionId, windowStartWallMs])
  @@index([userId, courseId, windowStartWallMs])
  @@index([courseId, windowStartWallMs])
  @@map("affective_state_windows")
}
