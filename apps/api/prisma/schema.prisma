// ─── Proposed Knowledge Components (AI-generated) ───────

enum ProposedKCStatus {
  PROPOSED
  APPROVED
  ARCHIVED
}

model ProposedKC {
  id              String           @id @default(uuid()) @db.Uuid
  courseId        String           @map("course_id") @db.Uuid
  name            String
  description     String?
  status          ProposedKCStatus @default(PROPOSED)
  confidenceLevel String           @default("MEDIUM") @map("confidence_level") // LOW, MEDIUM, HIGH
  createdBy       String           @default("ai") @map("created_by") // "ai" or "human"
  generationJobId String?          @map("generation_job_id") @db.Uuid
  relatedToKCId   String?          @map("related_to_kc_id") @db.Uuid
  evidence        Json             @default("[]") // [{pageId, blockIds, chunkIds}]
  pageIds         String[]         @map("page_ids") @db.Uuid
  topicId         String?          @map("topic_id") @db.Uuid
  subtopicId      String?          @map("subtopic_id") @db.Uuid // references CourseModule id
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  relatedTo  ProposedKC?   @relation("KCDuplicates", fields: [relatedToKCId], references: [id], onDelete: SetNull)
  duplicates ProposedKC[]  @relation("KCDuplicates")
  topic      Topic?        @relation(fields: [topicId], references: [id], onDelete: SetNull)
  subtopic   CourseModule? @relation(fields: [subtopicId], references: [id], onDelete: SetNull)

  // Graph edges where this KC is source or target
  outgoingEdges KcEdge[] @relation("KcEdgeFrom")
  incomingEdges KcEdge[] @relation("KcEdgeTo")

  // Content mappings
  contentMappings KcContentMapping[]

  @@index([courseId])
  @@index([status])
  @@index([courseId, status])
  @@index([topicId])
  @@index([subtopicId])
  @@map("proposed_kcs")
}

// ─── Knowledge Graph Edges (prerequisite relationships) ──

model KcEdge {
  id           String   @id @default(uuid()) @db.Uuid
  courseId     String   @map("course_id") @db.Uuid
  fromKcId     String   @map("from_kc_id") @db.Uuid
  toKcId       String   @map("to_kc_id") @db.Uuid
  relationship String   @default("prerequisite") // "prerequisite" | "related" | "builds_on"
  weight       Float    @default(1.0)
  createdBy    String   @default("ai") @map("created_by") // "ai" or "human"
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  fromKc ProposedKC @relation("KcEdgeFrom", fields: [fromKcId], references: [id], onDelete: Cascade)
  toKc   ProposedKC @relation("KcEdgeTo", fields: [toKcId], references: [id], onDelete: Cascade)

  @@unique([fromKcId, toKcId])
  @@index([courseId])
  @@map("kc_edges")
}

// ─── KC-to-Content Mapping Strength ─────────────────────

model KcContentMapping {
  id        String   @id @default(uuid()) @db.Uuid
