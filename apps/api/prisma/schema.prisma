generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────

enum UserRole {
  student
  teacher
  admin
}

enum QuestionType {
  text
  MCQ_SINGLE
  MCQ_MULTI
  STRUCTURED
}

enum AttemptStatus {
  in_progress
  submitted
  grading
  graded
}

enum GradedBy {
  auto
  manual
}

enum EventStatus {
  pending
  processing
  processed
  failed
}

enum InterventionType {
  PRACTICE_TESTING
  DISTRIBUTED_PRACTICE
  STEPWISE_LEARNING
  INTERROGATIVE_ELABORATION
}

enum InterventionStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

enum CourseStatus {
  DRAFT
  PUBLISHED
}

enum CourseVisibility {
  PUBLIC
  PRIVATE
}

enum ModuleItemType {
  PAGE
  PDF
  LINK
  ASSESSMENT
}

enum EnrollmentStatus {
  ACTIVE
  DROPPED
}

enum DraftStatus {
  DRAFT
  APPROVED
  REJECTED
}

enum ChunkingStrategy {
  FIXED_SIZE
  PARAGRAPH
  SEMANTIC
}

enum GenerationJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum QuestionGenJobStatus {
  PENDING
  RETRIEVING
  GENERATING
  REVIEW_READY
  COMPLETED
  FAILED
}

enum HattieFeedbackLevel {
  TASK
  PROCESS
  SELF_REGULATION
  SELF
}

enum LearningMode {
  STANDARD
  DIALOGUE
}

enum StudentFileType {
  PDF
  DOCX
  DOC
  TXT
  MD
  IMAGE_PNG
  IMAGE_JPG
  IMAGE_WEBP
  CODE
}

enum DocumentProcessingStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum RecordingUploadStatus {
  PENDING
  UPLOADING
  COMPLETED
  FAILED
}

enum PyfeatJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum StudioOutputType {
  BRIEFING_DOC
  FLASHCARD_SET
  TABLE_COMPARISON
  MIND_MAP
  TIMELINE
  FAQ
}

enum ActivityAction {
  // Session lifecycle
  SESSION_START
  SESSION_END
  SESSION_HEARTBEAT

  // Navigation
  MODULE_OPENED
  MODULE_ITEM_VIEWED
  KC_GRAPH_VIEWED

  // Assessments
  ASSESSMENT_STARTED
  QUESTION_VIEWED
  QUESTION_ANSWERED
  ASSESSMENT_SUBMITTED
  ASSESSMENT_GRADED

  // Dialogue / conversational AI
  DIALOGUE_SESSION_STARTED
  DIALOGUE_MESSAGE_SENT
  DIALOGUE_MESSAGE_RECEIVED
  DIALOGUE_SESSION_ENDED

  // Learning interventions
  INTERVENTION_TRIGGERED
  INTERVENTION_VIEWED
  INTERVENTION_COMPLETED
  INTERVENTION_DISMISSED

  // Spaced repetition
  SPACED_REP_CARD_VIEWED
  SPACED_REP_CARD_RATED

  // Study materials / RAG
  STUDY_MATERIAL_UPLOADED
  STUDY_GUIDE_GENERATED
  STUDIO_OUTPUT_REQUESTED
  STUDIO_OUTPUT_VIEWED

  // Mastery
  MASTERY_UPDATED

  // Feedback
  FEEDBACK_RECEIVED

  // Recording (Feature 04)
  RECORDING_STARTED
  RECORDING_STOPPED
  RECORDING_SEGMENT_UPLOADED
  RECORDING_UPLOAD_FAILED
  RECORDING_RESUMED

  // Pupil Size (Feature 01)
  PUPIL_SIZE_TRACKING_STARTED
  PUPIL_SIZE_TRACKING_STOPPED
  PUPIL_SIZE_BATCH_SUBMITTED

  // WebGazer (Feature 02)
  WEBGAZER_TRACKING_STARTED
  WEBGAZER_TRACKING_STOPPED
  WEBGAZER_CALIBRATION_STARTED
  WEBGAZER_CALIBRATION_COMPLETED
  WEBGAZER_CALIBRATION_SKIPPED
  WEBGAZER_BATCH_SUBMITTED
  WEBGAZER_RECALIBRATION_PROMPTED

  // py-feat (Feature 03)
  PYFEAT_JOB_ENQUEUED
  PYFEAT_JOB_COMPLETED
  PYFEAT_JOB_FAILED
}

// ─── Models ──────────────────────────────────────────────

model User {
  id              String   @id @default(uuid()) @db.Uuid
  email           String   @unique
  passwordHash    String   @map("password_hash")
  name            String
  role            UserRole
  llmProvider     String?  @map("llm_provider") // e.g. "openai"
  encryptedApiKey String?  @map("encrypted_api_key")
  llmModel        String?  @map("llm_model") // e.g. "gpt-4o-mini"

  // Onboarding fields
  isTemporaryPassword Boolean   @default(false) @map("is_temporary_password")
  invitedBy           String?   @map("invited_by") @db.Uuid
  invitedAt           DateTime? @map("invited_at") @db.Timestamptz
  passwordChangedAt   DateTime? @map("password_changed_at") @db.Timestamptz

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  taughtCourses            Course[]                   @relation("TeacherCourses")
  enrollments              Enrollment[]
  attempts                 Attempt[]
  gradingResults           GradingResult[]            @relation("GraderResults")
  masteries                UserMastery[]
  uploadedDocuments        SourceDocument[]           @relation("UploadedDocuments")
  createdDrafts            ContentDraft[]             @relation("CreatedDrafts")
  learningInterventions    LearningIntervention[]
  savedInterventionReviews SavedInterventionReview[]
  teacherPromptConfigs     InterventionPromptConfig[] @relation("teacherPromptConfigs")
  spacedRepetitionCards    SpacedRepetitionCard[]
  questionGenerationJobs   QuestionGenerationJob[]
  feedbackPromptConfigs    FeedbackPromptConfig[]     @relation("teacherFeedbackConfigs")
  llmUsageLogs             LlmUsageLog[]
  studentDocuments         StudentSourceDocument[]    @relation("StudentDocuments")
  dialogueSessions         DialogueSession[]          @relation("StudentDialogueSessions")
  dialogueNotes            DialogueNote[]             @relation("StudentNotes")
  studentSessions          StudentSession[]
  activityLogs             ActivityLog[]
  sessionSummaries         SessionSummary[]
  learningEpisodes         LearningEpisode[]

  // Biometrics relations
  recordingSegments    RecordingSegment[]
  recordingConsents    RecordingConsent[]
  pupilSizeLogs        PupilSizeLog[]
  webgazerLogs         WebgazerLog[]
  webgazerCalibrations WebgazerCalibrationEvent[]
  pyfeatJobs           PyfeatJob[]

  @@map("users")
}

model Course {
  id            String           @id @default(uuid()) @db.Uuid
  title         String
  description   String
  teacherId     String           @map("teacher_id") @db.Uuid
  status        CourseStatus     @default(DRAFT)
  visibility    CourseVisibility @default(PRIVATE)
  bannerBlobKey String?          @map("banner_blob_key")
  orderIndex    Int              @default(0) @map("order_index")
  learningMode  LearningMode     @default(STANDARD) @map("learning_mode")
  dblSettings   Json?            @map("dbl_settings")
  archivedAt    DateTime?        @map("archived_at") @db.Timestamptz
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  teacher          User                    @relation("TeacherCourses", fields: [teacherId], references: [id], onDelete: Cascade)
  topics           Topic[]
  enrollments      Enrollment[]
  assessments      Assessment[]
  questions        Question[]
  modules          CourseModule[]
  sourceDocuments  SourceDocument[]
  contentDrafts    ContentDraft[]
  studentDocuments StudentSourceDocument[]
  dialogueSessions DialogueSession[]
  studentSessions  StudentSession[]

  // Biometrics relations
  recordingConfig        RecordingConfig?
  recordingSegments      RecordingSegment[]
  recordingConsents      RecordingConsent[]
  pupilSizeConfig        PupilSizeConfig?
  pupilSizeLogs          PupilSizeLog[]
  webgazerConfig         WebgazerConfig?
  webgazerLogs           WebgazerLog[]
  webgazerCalibrations   WebgazerCalibrationEvent[]
  pyfeatConfig           PyfeatConfig?
  affectiveMappingConfig AffectiveMappingConfig?
  pyfeatJobs             PyfeatJob[]

  // Retrospective tracing
  learningEpisodes LearningEpisode[]

  @@index([teacherId])
  @@map("courses")
}

model Enrollment {
  id         String           @id @default(uuid()) @db.Uuid
  studentId  String           @map("student_id") @db.Uuid
  courseId   String           @map("course_id") @db.Uuid
  status     EnrollmentStatus @default(ACTIVE)
  enrolledAt DateTime         @default(now()) @map("enrolled_at") @db.Timestamptz

  student          User                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  course           Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  studentDocuments StudentSourceDocument[]
  dialogueSessions DialogueSession[]

  @@unique([studentId, courseId])
  @@index([courseId])
  @@map("enrollments")
}

model Topic {
  id              String   @id @default(uuid()) @db.Uuid
  courseId        String   @map("course_id") @db.Uuid
  title           String
  description     String
  orderIndex      Int      @map("order_index")
  generationJobId String?  @map("generation_job_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  course              Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions           Question[]
  knowledgeComponents KnowledgeComponent[]
  modules             CourseModule[]
  proposedKCs         ProposedKC[]

  @@index([courseId])
  @@map("topics")
}

model Question {
  id         String       @id @default(uuid()) @db.Uuid
  courseId   String?      @map("course_id") @db.Uuid
  topicId    String?      @map("topic_id") @db.Uuid
  version    Int          @default(1)
  prompt     String // legacy: plain text stem
  stem       Json? // rich content blocks (new)
  type       QuestionType
  maxScore   Float        @map("max_score")
  rubricJson Json?        @map("rubric_json")

  // MCQ fields (JSON arrays)
  options         Json? // [{id, text, isCorrect}]
  correctOptionId String? @map("correct_option_id") // MCQ_SINGLE: id of correct option
  correctAnswer   Json?   @map("correct_answer") // STRUCTURED: rubric/key points/sample solution

  // Rich explanation / worked solution
  explanation Json? // rich blocks for worked solution

  // Tags (stored as JSON for flexibility)
  difficulty  Int?     @default(3) // 1-5
  bloomsLevel String?  @map("blooms_level") // remember/understand/apply/analyze/evaluate/create
  kcIds       String[] @map("kc_ids") @db.Uuid // course-scoped KC links
  pageIds     String[] @map("page_ids") @db.Uuid // links to lesson pages
  tags        Json? // additional custom tags

  // AI generation metadata
  answerKey            Json?  @map("answer_key") // Structured answer key (varies by type)
  difficultyConfidence Float? @map("difficulty_confidence") // AI confidence in difficulty (0-1)
  gradingConfig        Json?  @map("grading_config") // {feedbackLevel, customInstructions}

  // Metadata
  status     String  @default("draft") // draft/approved/archived
  createdBy  String? @map("created_by") // "admin" | "ai"
  sourceType String? @map("source_type") // "lesson_based" | "uploaded" | "mixed"
  provenance Json? // {sourceDocIds, chunkIds}

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  course              Course?              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topic               Topic?               @relation(fields: [topicId], references: [id], onDelete: Cascade)
  attempts            Attempt[]
  assessmentQuestions AssessmentQuestion[]
  questionKcs         QuestionKc[]

  @@index([courseId])
  @@index([topicId])
  @@index([status])
  @@index([type])
  @@map("questions")
}

model Attempt {
  id                String        @id @default(uuid()) @db.Uuid
  studentId         String        @map("student_id") @db.Uuid
  questionId        String        @map("question_id") @db.Uuid
  assessmentId      String?       @map("assessment_id") @db.Uuid
  status            AttemptStatus @default(in_progress)
  textResponse      String?       @map("text_response")
  selectedOptionIds Json?         @map("selected_option_ids") // string[] for MCQ answers
  currentScore      Float?        @map("current_score")
  autoFeedback      String?       @map("auto_feedback") // auto-generated feedback for MCQ
  submittedAt       DateTime?     @map("submitted_at") @db.Timestamptz
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  student        User            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  question       Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  gradingResults GradingResult[]

  @@index([studentId])
  @@index([questionId])
  @@index([assessmentId])
  @@map("attempts")
}

model GradingResult {
  id             String   @id @default(uuid()) @db.Uuid
  attemptId      String   @map("attempt_id") @db.Uuid
  score          Float
  feedback       String
  gradedBy       GradedBy @map("graded_by")
  graderId       String?  @map("grader_id") @db.Uuid
  aiFeedbackJson Json?    @map("ai_feedback_json") // Structured Hattie feedback levels
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  attempt    Attempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  grader     User?        @relation("GraderResults", fields: [graderId], references: [id], onDelete: SetNull)
  kcEvidence KcEvidence[]

  @@index([attemptId])
  @@index([graderId])
  @@map("grading_results")
}

model EventQueue {
  id          String      @id @default(uuid()) @db.Uuid
  topic       String
  payload     Json
  status      EventStatus @default(pending)
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz
  processedAt DateTime?   @map("processed_at") @db.Timestamptz

  @@index([topic, status])
  @@map("event_queue")
}

model Assessment {
  id          String   @id @default(uuid()) @db.Uuid
  courseId    String   @map("course_id") @db.Uuid
  title       String
  description String   @default("")
  mode        String   @default("practice") // "practice" | "test"
  isPublished Boolean  @default(false) @map("is_published")
  settings    Json? // {timeLimit, maxAttempts, showSolutions, shuffle}
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  course    Course               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  questions AssessmentQuestion[]

  @@index([courseId])
  @@map("assessments")
}

model AssessmentQuestion {
  id           String  @id @default(uuid()) @db.Uuid
  assessmentId String  @map("assessment_id") @db.Uuid
  questionId   String  @map("question_id") @db.Uuid
  orderIndex   Int     @map("order_index")
  points       Float?  @default(1) // points for this question in this assessment
  section      String? // optional section grouping

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  question   Question   @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, questionId])
  @@index([assessmentId])
  @@map("assessment_questions")
}

// ─── Course Modules & Items ─────────────────────────────

model CourseModule {
  id              String   @id @default(uuid()) @db.Uuid
  courseId        String   @map("course_id") @db.Uuid
  topicId         String?  @map("topic_id") @db.Uuid
  title           String
  orderIndex      Int      @map("order_index")
  generationJobId String?  @map("generation_job_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz

  course      Course       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topic       Topic?       @relation(fields: [topicId], references: [id], onDelete: SetNull)
  items       ModuleItem[]
  proposedKCs ProposedKC[]

  @@index([courseId])
  @@index([topicId])
  @@map("course_modules")
}

model ModuleItem {
  id         String         @id @default(uuid()) @db.Uuid
  moduleId   String         @map("module_id") @db.Uuid
  type       ModuleItemType
  title      String
  orderIndex Int            @map("order_index")

  // PAGE type
  contentMdx String? @map("content_mdx")

  // PDF type
  pdfBlobKey  String? @map("pdf_blob_key")
  pdfFilename String? @map("pdf_filename")
  pdfSize     Int?    @map("pdf_size")

  // LINK type
  url String?

  // ASSESSMENT type
  assessmentId String? @map("assessment_id") @db.Uuid

  // AI-generated metadata
  learningOutcomes Json?   @map("learning_outcomes") // string[]
  estimatedMinutes Int?    @map("estimated_minutes")
  generationJobId  String? @map("generation_job_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  module   CourseModule         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  versions PageContentVersion[]

  @@index([moduleId])
  @@map("module_items")
}

model PageContentVersion {
  id          String   @id @default(uuid()) @db.Uuid
  itemId      String   @map("item_id") @db.Uuid
  version     Int
  contentJson String   @map("content_json") // BlockDocument JSON
  source      String // "human" | "ai" | "rollback"
  authorId    String?  @map("author_id") @db.Uuid
  jobId       String?  @map("job_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  item ModuleItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([itemId, version])
  @@index([itemId])
  @@map("page_content_versions")
}

// ─── RAG: Source Documents & Chunks ──────────────────────

model SourceDocument {
  id               String           @id @default(uuid()) @db.Uuid
  courseId         String           @map("course_id") @db.Uuid
  uploadedById     String           @map("uploaded_by_id") @db.Uuid
  title            String
  filename         String
  blobKey          String           @map("blob_key")
  mimeType         String           @map("mime_type")
  sizeBytes        Int              @map("size_bytes")
  pageCount        Int?             @map("page_count")
  chunkingStrategy ChunkingStrategy @default(PARAGRAPH) @map("chunking_strategy")
  chunkCount       Int              @default(0) @map("chunk_count")
  indexedAt        DateTime?        @map("indexed_at") @db.Timestamptz
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  course     Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  uploadedBy User            @relation("UploadedDocuments", fields: [uploadedById], references: [id], onDelete: Cascade)
  chunks     DocumentChunk[]

  @@index([courseId])
  @@map("source_documents")
}

model DocumentChunk {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  chunkIndex Int      @map("chunk_index")
  content    String
  pageNumber Int?     @map("page_number")
  tokenCount Int      @default(0) @map("token_count")
  embedding  Json? // stored as float array in JSON
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  document SourceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, chunkIndex])
  @@index([documentId])
  @@map("document_chunks")
}

// ─── Dialogue-Based Learning (DBL) ──────────────────────

model StudentSourceDocument {
  id               String                   @id @default(cuid())
  enrollmentId     String                   @map("enrollment_id") @db.Uuid
  enrollment       Enrollment               @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  studentId        String                   @map("student_id") @db.Uuid
  student          User                     @relation("StudentDocuments", fields: [studentId], references: [id])
  courseId         String                   @map("course_id") @db.Uuid
  course           Course                   @relation(fields: [courseId], references: [id])
  sessionId        String?                  @map("session_id")
  session          DialogueSession?         @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  fileName         String                   @map("file_name")
  originalName     String                   @map("original_name")
  mimeType         String                   @map("mime_type")
  fileSize         Int                      @map("file_size")
  blobKey          String                   @map("blob_key")
  fileType         StudentFileType          @map("file_type")
  processingStatus DocumentProcessingStatus @default(PENDING) @map("processing_status")
  processingError  String?                  @map("processing_error")
  isActive         Boolean                  @default(true) @map("is_active")
  autoGuide        StudentSourceGuide?
  chunks           StudentRagChunk[]
  dialogueNotes    DialogueNote[]
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz

  @@index([enrollmentId])
  @@index([studentId, courseId])
  @@index([sessionId])
  @@map("student_source_documents")
}

model StudentSourceGuide {
  id                 String                @id @default(cuid())
  documentId         String                @unique @map("document_id")
  document           StudentSourceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  summary            String                @db.Text
  tableOfContents    Json                  @map("table_of_contents")
  suggestedQuestions Json                  @map("suggested_questions")
  keyTopics          Json                  @map("key_topics")
  generatedAt        DateTime              @default(now()) @map("generated_at") @db.Timestamptz
  updatedAt          DateTime              @updatedAt @map("updated_at") @db.Timestamptz

  @@map("student_source_guides")
}

model StudentRagChunk {
  id         String                @id @default(cuid())
  documentId String                @map("document_id")
  document   StudentSourceDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  studentId  String                @map("student_id") @db.Uuid
  courseId   String                @map("course_id") @db.Uuid
  content    String                @db.Text
  embedding  Json?
  chunkIndex Int                   @map("chunk_index")
  pageNumber Int?                  @map("page_number")
  metadata   Json?
  createdAt  DateTime              @default(now()) @map("created_at") @db.Timestamptz

  @@index([documentId])
  @@index([studentId, courseId])
  @@map("student_rag_chunks")
}

model DialogueSession {
  id                  String                  @id @default(cuid())
  enrollmentId        String                  @map("enrollment_id") @db.Uuid
  enrollment          Enrollment              @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  studentId           String                  @map("student_id") @db.Uuid
  student             User                    @relation("StudentDialogueSessions", fields: [studentId], references: [id])
  courseId            String                  @map("course_id") @db.Uuid
  course              Course                  @relation(fields: [courseId], references: [id])
  title               String                  @default("New Session")
  activeSourceIds     String[]                @map("active_source_ids")
  documents           StudentSourceDocument[]
  messages            DialogueMessage[]
  studioOutputs       StudioOutput[]
  dialogueNotes       DialogueNote[]
  linkedInterventions LearningIntervention[]
  createdAt           DateTime                @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime                @updatedAt @map("updated_at") @db.Timestamptz

  @@index([enrollmentId])
  @@index([studentId, courseId])
  @@map("dialogue_sessions")
}

model DialogueMessage {
  id         String          @id @default(cuid())
  sessionId  String          @map("session_id")
  session    DialogueSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role       MessageRole
  content    String          @db.Text
  citations  Json?
  tokenUsage Json?           @map("token_usage")
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz

  @@index([sessionId])
  @@map("dialogue_messages")
}

model StudioOutput {
  id        String           @id @default(cuid())
  sessionId String           @map("session_id")
  session   DialogueSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  studentId String           @map("student_id") @db.Uuid
  type      StudioOutputType
  title     String
  content   Json
  sourceIds String[]         @map("source_ids")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
